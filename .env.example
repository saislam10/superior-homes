# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are embedded in client JavaScript at build
# time — never put secrets in them.

# --- Site -------------------------------------------------------------------
# Canonical origin. Defaults to https://wichitabuild.com when unset.
NEXT_PUBLIC_SITE_URL=

# Search engine indexing. Leave unset (or "false") everywhere except the
# production deployment, and only after the pre-launch checklist is complete.
# When not "true", robots.txt disallows all crawling and pages are noindex.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Contact form delivery (server-only) --------------------------------------
# One of: webhook | resend. Leave unset to disable delivery — visitors will be
# told plainly that their message was NOT sent.
CONTACT_DELIVERY_PROVIDER=

# provider=webhook — JSON POST to a CRM/automation endpoint.
CONTACT_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# provider=resend — email via https://resend.com
RESEND_API_KEY=
# Inbox that receives inquiries.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Superior Homes Website <website@wichitabuild.com>".
CONTACT_FROM_EMAIL=

# --- Search & analytics (optional) --------------------------------------------
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. No analytics script
# loads when unset. Update the privacy policy before enabling.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
